    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.mjs analyze demo/session.jsonl --repo demo/repo",
    "demo": "node demo/demo.mjs",
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "context",
    "claude-code",
    "codex",
    "transcript",
    "cli"
  ],
