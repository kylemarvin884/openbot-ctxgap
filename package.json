{
  "name": "ctxgap",
  "version": "0.1.0",
  "description": "Find the repo files that would have prevented your coding agent's failed turns — and that it never opened. Zero-dependency Node CLI.",
  "type": "module",
  "bin": {
    "ctxgap": "./src/cli.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
